<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude malicious code reporting for DTOs returning arrays or lists -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION" />
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW,SE_TRANSIENT_FIELD_NOT_RESTORED,SE_BAD_FIELD,CWO_CLOSED_WITHOUT_OPENED,NP_BOOLEAN_RETURN_NULL,SE_BAD_FIELD_STORE,UCF_USELESS_CONTROL_FLOW,RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE" />
    </Match>
</FindBugsFilter>
